# UVCE environment template. Copy to .env.local for local overrides. Never commit real secrets.

# --- Browser app (VITE_* values are embedded into the client bundle: never put secrets here) ---
VITE_ASSET_BASE_URL=/uvce-compiled
VITE_DEFAULT_BACKEND=webgl2
VITE_ENABLE_AI_ASSET_PIPELINE=false

# --- Optional server-side asset factory bridge (NOT implemented / NOT connected in Milestone 0) ---
# These are read only by a future server-side adapter. They must never be exposed with a VITE_ prefix.
RUNPOD_MODE=disabled         # disabled | pod-http | serverless
RUNPOD_ENDPOINT_URL=
RUNPOD_API_KEY=
BLENDER_MCP_ENABLED=false
IMAGE_PROVIDER_ENABLED=false
